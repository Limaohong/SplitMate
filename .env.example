# 複製為 .env 後修改：cp .env.example .env
# .env 已被 .gitignore 排除，請勿提交到版控

# ---- PostgreSQL ----
POSTGRES_DB=splitmate
POSTGRES_USER=splitmate
# 正式環境務必換成強密碼，例如：openssl rand -base64 24
POSTGRES_PASSWORD=change-me-db-password
# 只綁定 127.0.0.1，方便本機用 IDE / DB 工具連線；VPS 上外部無法直接連到 DB
POSTGRES_HOST_PORT=5432

# ---- Backend ----
# 階段 2 起使用。至少 32 bytes 的隨機字串（HS256 要求 >= 256 bits），例如：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long

# ---- Nginx ----
# 對外 HTTP port；本機若 80 被占用可改成 8000 等
NGINX_HTTP_PORT=80
